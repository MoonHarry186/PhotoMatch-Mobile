# Public runtime values are embedded in the application bundle and are not secrets.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=http://localhost:53000
EXPO_PUBLIC_WS_URL=http://localhost:53000
EXPO_PUBLIC_APP_LINK_HOST=dev-app.photomatch.vn
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_ANALYTICS_PROVIDER=disabled

# Build/service credentials such as Apple keys, Google service files, Sentry auth
# tokens and store credentials belong in EAS Sensitive/Secret variables. They
# MUST NOT use EXPO_PUBLIC_ or be committed to this repository.
